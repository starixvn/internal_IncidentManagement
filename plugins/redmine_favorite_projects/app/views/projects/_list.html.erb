<% if @projects.empty? %>
    <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<div class="autoscroll">
  <table class="list">
    <thead><tr>
    <th></th>
    <% @query.columns.each do |column| %>
      <% column_header = column.caption
        if(column_header == "Name")
            column_header = "Categories" %>
      <% end %>
      <%= content_tag('th', h(column_header)) %>
    <% end %>
    </tr></thead>
    <tbody>
      <% project_tree(@projects) do |project, level| %>
        <tr class="<%= cycle("odd", "even") %> <%= project.css_classes %> <%= level > 0 ? "idnt idnt-#{level}" : nil %>">
            <td><%= favorite_tag(project, User.current) %></td>
              <% @query.columns.each do |column| %>
                <% project.description = Nokogiri::HTML(project.description).text %>
                <%= content_tag 'td', column_content(column, project), :class => column.css_classes %>
              <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% end %>
