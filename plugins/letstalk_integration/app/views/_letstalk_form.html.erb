<p class="hidden lbl-letstalk-checkbox">
	<%= label_tag 'Letstalk' %>
	<%= check_box 'chkLetstalk','yesno_attribute', {}, 'yes', 'no' %>
</p>
<p class="hidden lbl-letstalk-comment">
	<%= label_tag 'Letstalk Comment' %>
	<%= text_area_tag 'txtletstalk', nil, rows: 3, cols: 90, placeholder: 'Enter your comment...' %>
</p>

<%= javascript_include_tag 'application.js', :plugin => 'letstalk_integration' %>
