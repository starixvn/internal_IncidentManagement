<div id="issue_table_guide" style="display: none;">
	<fieldset class="collapsible">
      <legend onclick="toggleFieldset(this);"><strong>Color Guide</strong></legend>
      <div>
        <table class="issue-table-guide">
          <tr>
            <td width="45px" style="background: #FDEEE8;" class="issue-guide-block"></td>
            <td>Item(s) has been updated within 24 hours</td>
          </tr>
          <tr>
            <td width="45px" style="background: #EAF7FF;" class="issue-guide-block"></td>
            <td>Item(s) is tagged as P1 (Critical Impact)</td>
          </tr>
          <tr>
            <td width="45px" style="background: #FFFFDD;" class="issue-guide-block"></td>
            <td>Item(s) highlighted</td>
          </tr>
          <tr>
            <td width="45px" style="background: #507AAA;" class="issue-guide-block"></td>
            <td>Item(s) selected</td>
          </tr>
          <tr>
            <td width="45px" style="background: #F6F7F8;" class="issue-guide-block"></td>
            <td>Odd line</td>
          </tr>
          <tr>
            <td width="45px" class="issue-guide-block"></td>
            <td>Even line</td>
          </tr>
        </table>
      </div>
	</fieldset>
</div>
<%= javascript_include_tag 'redmine_incident.js', :plugin => 'redmine_incident' %>

