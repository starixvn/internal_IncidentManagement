</td>\r\n\t\t</tr>\r\n\t</tbody>\r\n</table>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n", "status_id"=>"3", "priority_id"=>"2", "assigned_to_id"=>"55", "start_date"=>"2016-11-16", "due_date"=>"2016-11-17", "custom_field_values"=>{"8"=>["Allbet", ""], "3"=>["Credit-Member", ""], "23"=>["Desktop", ""], "4"=>["3rd Party", ""], "19"=>"Pending yet settle", "15"=>"WWBO881BQ", "7"=>"Due to internet connection was not stable, that caused we didn't recieve the cancel bet request from Allbet and the ticket bet amount is different.", "17"=>"N/A", "16"=>"Allbet have no such mechanism to resend the cancel request to our API, so we asked them to provide the cancel request to cancel one of the transaction with $5, and do the fix in our side. The ticket is settled now."}, "notes"=>"", "private_notes"=>"0", "lock_version"=>"1"}, "issue_template"=>"", "new_checklist"=>"", "last_journal_id"=>"341", "commit"=>"Submit", "id"=>"105"}
