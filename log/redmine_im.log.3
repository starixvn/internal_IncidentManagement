blem.</p>\r\n\r\n\t\t\t<p>But this problem not affect to real tickets. We will fix this issue later due to other higher priority tasks/request</p>\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td style=\"text-align:center\">&nbsp;</td>\r\n\t\t\t<td>&nbsp;</td>\r\n\t\t</tr>\r\n\t</tbody>\r\n</table>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n", "status_id"=>"4", "priority_id"=>"3", "assigned_to_id"=>"157", "start_date"=>"2016-11-05", "due_date"=>"", "custom_field_values"=>{"8"=>["Sportsbook", ""], "3"=>["NAP-Settlement", ""], "4"=>["Application", ""], "19"=>"None", "15"=>"None", "7"=>"N/A", "17"=>"", "16"=>""}, "notes"=>"", "private_notes"=>"0", "lock_version"=>"3"}, "issue_template"=>"", "last_journal_id"=>"311", "commit"=>"Submit", "id"=>"85"}
